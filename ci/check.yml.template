name: Check
on: [push, pull_request]
permissions:
  contents: read
jobs:
  desktop:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      - run: bash scripts/build_desktop.sh
      - run: ./build/simulator < simulator/demo.txt
      - run: ./build/simulator < simulator/motion-demo.txt
  firmware:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      - run: python -m pip install platformio==6.1.18
      - run: pio run -e m5atoms3r_cam -e m5atoms3r_cam_u059 -e esp32dev
